{
  "name": "stock",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-02",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": true
  }
}
