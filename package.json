{
  "name": "stock",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "dev:api": "uv run --project backend uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000",
    "test:api": "uv run --project backend pytest backend/tests",
    "data": "node scripts/fetch-h30269.mjs",
    "data:update": "node scripts/fetch-h30269.mjs --verbose",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test",
    "preview": "vite preview"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "lucide-vue-next": "^0.577.0",
    "naive-ui": "^2.45.3",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^8.2.2",
    "wrangler": "^4.128.0"
  }
}
