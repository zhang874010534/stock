{
  "name": "stock",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "data": "node scripts/fetch-market.mjs",
    "data:update": "node scripts/fetch-market.mjs --verbose",
    "data:metrics": "node scripts/build-latest-metrics.mjs",
    "data:constituents": "python scripts/fetch-constituents.py",
    "data:refresh-market": "node scripts/update-latest-metrics.mjs market",
    "data:refresh-indicators": "node scripts/update-latest-metrics.mjs indicators",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test",
    "preview": "vite preview",
    "test:collectors": "python -m unittest discover -s tests -p test_*.py",
    "calendar:check": "node scripts/check-trading-calendar.mjs"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "lucide-vue-next": "^0.577.0",
    "naive-ui": "^2.45.3",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^8.2.2",
    "wrangler": "^4.128.0"
  }
}
